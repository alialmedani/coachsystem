{
  "App": {
    "SelfUrl": "https://localhost:44370",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=CoachApp;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://localhost:44370",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "CoachApp_Swagger",
    "CertificatePassPhrase": "55b242e7-c780-4af1-a9a5-15816d75f062"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "zVb6zIoCQ9gHdPyW"
  }}